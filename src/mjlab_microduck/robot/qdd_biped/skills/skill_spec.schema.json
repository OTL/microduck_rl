{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OTL/microduck_rl/qdd_biped/skill_spec.schema.json",
  "title": "QDD biped skill spec (schema_version 1)",
  "description": "A short whole-body skill that starts and ends in the standing pose. Structural schema only: tasks/qdd_skill.py validate_spec is the authoritative gate (it also checks timing, the pose-dependent knee limit, joint / torso speeds, torso tilt and height, flat parallel soles and static balance). Safety limits, terminations, observations, actions and domain randomisation are fixed by the task template and cannot be set here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "duration_s", "keyframes"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
    "description": {"type": "string", "maxLength": 500},
    "duration_s": {
      "type": "number", "minimum": 1.0, "maximum": 8.0,
      "description": "Length of the motion; the last keyframe is at t = duration_s."
    },
    "settle_s": {
      "type": "number", "minimum": 0.5, "maximum": 3.0, "default": 1.0,
      "description": "Return-to-stand phase after the motion: the standing pose is held and rewarded."
    },
    "interpolation": {
      "enum": ["minjerk", "linear"], "default": "minjerk",
      "description": "minjerk = smooth, zero velocity at every keyframe."
    },
    "support": {
      "enum": ["both_feet"], "default": "both_feet",
      "description": "both_feet: both soles stay flat on the floor the whole time."
    },
    "keyframes": {
      "type": "array", "minItems": 2, "maxItems": 16,
      "description": "Times strictly increasing, >= 0.2 s apart; first at t = 0 and last at t = duration_s, both the standing pose (no joints_deg / torso).",
      "items": {"$ref": "#/$defs/keyframe"}
    },
    "reward_weights": {
      "type": "object", "additionalProperties": false,
      "description": "Optional; penalties are magnitudes (applied negative). Defaults in tasks/qdd_skill.py REWARD_WEIGHT_BOUNDS.",
      "properties": {
        "joint_tracking": {"type": "number", "minimum": 0.0, "maximum": 6.0, "default": 3.0},
        "torso_orientation": {"type": "number", "minimum": 0.0, "maximum": 6.0, "default": 2.0},
        "torso_height": {"type": "number", "minimum": 0.0, "maximum": 3.0, "default": 1.0},
        "balance": {"type": "number", "minimum": 0.5, "maximum": 3.0, "default": 1.0},
        "feet_contact": {"type": "number", "minimum": 0.5, "maximum": 3.0, "default": 1.0},
        "final_stand": {"type": "number", "minimum": 0.5, "maximum": 5.0, "default": 2.0},
        "action_rate": {"type": "number", "minimum": 0.02, "maximum": 0.5, "default": 0.1},
        "joint_torques": {"type": "number", "minimum": 5e-05, "maximum": 0.001, "default": 0.0002},
        "foot_slip": {"type": "number", "minimum": 0.5, "maximum": 3.0, "default": 1.0}
      }
    }
  },
  "$defs": {
    "keyframe": {
      "type": "object", "additionalProperties": false, "required": ["t"],
      "properties": {
        "t": {"type": "number", "minimum": 0.0, "maximum": 8.0},
        "joints_deg": {"$ref": "#/$defs/joints_deg"},
        "torso": {
          "type": "object", "additionalProperties": false,
          "description": "Optional cross-check of the pose the joints give with flat soles (pitch + = nose down, roll + = left side up, height of the torso origin above the floor; standing = 0, 0, 0.344).",
          "properties": {
            "pitch_deg": {"type": "number", "minimum": -15.0, "maximum": 30.0},
            "roll_deg": {"type": "number", "minimum": -10.0, "maximum": 10.0},
            "height_m": {"type": "number", "minimum": 0.24, "maximum": 0.40}
          }
        },
        "note": {"type": "string", "maxLength": 200}
      }
    },
    "joints_deg": {
      "type": "object", "additionalProperties": false,
      "description": "Absolute joint angles in degrees; unlisted joints keep the standing value (hip_pitch -22.5, knee 45, ankle_pitch -22.5, others 0). A side-less name sets both legs mirror-symmetrically (yaw / roll negate on the right leg). Ranges are the joint ranges minus 3 deg.",
      "properties": {
        "hip_yaw": {"type": "number", "minimum": -27.0, "maximum": 27.0},
        "hip_roll": {"type": "number", "minimum": -22.0, "maximum": 17.0},
        "hip_pitch": {"type": "number", "minimum": -97.0, "maximum": 37.0},
        "knee": {"type": "number", "minimum": 0.0, "maximum": 117.0},
        "ankle_pitch": {"type": "number", "minimum": -47.0, "maximum": 47.0},
        "l_hip_yaw": {"type": "number", "minimum": -27.0, "maximum": 27.0},
        "l_hip_roll": {"type": "number", "minimum": -22.0, "maximum": 17.0},
        "l_hip_pitch": {"type": "number", "minimum": -97.0, "maximum": 37.0},
        "l_knee": {"type": "number", "minimum": 0.0, "maximum": 117.0},
        "l_ankle_pitch": {"type": "number", "minimum": -47.0, "maximum": 47.0},
        "r_hip_yaw": {"type": "number", "minimum": -27.0, "maximum": 27.0},
        "r_hip_roll": {"type": "number", "minimum": -17.0, "maximum": 22.0},
        "r_hip_pitch": {"type": "number", "minimum": -97.0, "maximum": 37.0},
        "r_knee": {"type": "number", "minimum": 0.0, "maximum": 117.0},
        "r_ankle_pitch": {"type": "number", "minimum": -47.0, "maximum": 47.0}
      }
    }
  }
}
